# Base URL of the ASP.NET Core API (no trailing slash).
VITE_API_URL=http://localhost:5090

# When the API can't be reached, show the bundled demo content instead of an error.
VITE_DEMO_FALLBACK=true

# Static portfolio deploy with no backend at all: never call the API.
VITE_DEMO_ONLY=false

# "browser" (clean URLs, needs SPA rewrites on the host) or "hash" (works on any static host).
VITE_ROUTER=browser

# Public site URL, used for canonical links.
VITE_SITE_URL=http://localhost:5174

# Asset base path. "/" normally; "./" for a sub-path static deploy (use with VITE_ROUTER=hash).
VITE_BASE=/
